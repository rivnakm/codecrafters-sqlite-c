// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug cc-sqlite",
    "build": {
      "command": "just",
      "args": ["build", "debug"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/build/sqlite",
    "args": ["sample.db", "SELECT COUNT(*) FROM apples"],
    "request": "launch",
    "adapter": "CodeLLDB"
  }
]
